#!/bin/sh
# Start-or-attach the always-on tmux session "ping-assistant" running bin/ping-assistant-up.
#   bin/ping-assistant-session             attach (create the session first if missing)
#   bin/ping-assistant-session --detached  only make sure it is running (for launchd)
# Closing the terminal only detaches; the session keeps running.
TMUX_BIN=/opt/homebrew/bin/tmux
SESSION=ping-assistant
REPO=$(cd "$(dirname "$0")/.." && pwd) || exit 1

CLAUDE_BIN=$(PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:$PATH" command -v claude)
[ -n "$CLAUDE_BIN" ] || CLAUDE_BIN="$HOME/.local/bin/claude"
RUN_PATH="$(dirname "$CLAUDE_BIN"):$HOME/.bun/bin:/opt/homebrew/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

DETACHED=0
[ "$1" = "--detached" ] && DETACHED=1

if ! "$TMUX_BIN" has-session -t "=$SESSION" 2>/dev/null; then
  "$TMUX_BIN" new-session -d -s "$SESSION" -c "$REPO" -e "PATH=$RUN_PATH" "$REPO/bin/ping-assistant-up" || exit 1
fi
[ "$DETACHED" = 1 ] && exit 0

if [ -n "$TMUX" ]; then
  exec "$TMUX_BIN" switch-client -t "=$SESSION"
fi
exec "$TMUX_BIN" attach -t "=$SESSION"
