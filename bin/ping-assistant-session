#!/bin/sh
# Start-or-attach the always-on tmux session "ping-assistant" running bin/ping-assistant-up.
#   bin/ping-assistant-session             attach (create the session first if missing)
#   bin/ping-assistant-session --detached  only make sure it is running (for launchd)
# Closing the terminal only detaches; the session keeps running.
TMUX_BIN=/opt/homebrew/bin/tmux
SESSION=ping-assistant
REPO=$(cd "$(dirname "$0")/.." && pwd) || exit 1

CLAUDE_BIN=$(PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:$PATH" command -v claude)
[ -n "$CLAUDE_BIN" ] || CLAUDE_BIN="$HOME/.local/bin/claude"
RUN_PATH="$(dirname "$CLAUDE_BIN"):$HOME/.bun/bin:/opt/homebrew/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

DETACHED=0
[ "$1" = "--detached" ] && DETACHED=1

if ! "$TMUX_BIN" has-session -t "=$SESSION" 2>/dev/null; then
  # `env PATH=…` on the command itself: tmux's -e does not reach the first command of a fresh
  # tmux server, which otherwise inherits a PATH without bun/claude.
  "$TMUX_BIN" new-session -d -s "$SESSION" -c "$REPO" -e "PATH=$RUN_PATH" \
    "env PATH='$RUN_PATH' '$REPO/bin/ping-assistant-up'" || exit 1
  # Claude Code asks an interactive "I am using this for local development" confirmation for
  # --dangerously-load-development-channels; nobody is at the keyboard under launchd, so answer it.
  echo "ping-assistant-session: waiting for the dev-channels prompt" >&2
  i=0
  while [ $i -lt 240 ]; do
    # pane targets take "session:" (the "=name" exact form is only for session targets)
    if "$TMUX_BIN" capture-pane -p -t "$SESSION:" 2>/dev/null | grep -q 'local development'; then
      "$TMUX_BIN" send-keys -t "$SESSION:" Enter
      echo "ping-assistant-session: dev-channels prompt confirmed" >&2
      break
    fi
    sleep 0.5
    i=$((i + 1))
  done
  [ $i -ge 240 ] && echo "ping-assistant-session: prompt not seen within 120s" >&2
fi
[ "$DETACHED" = 1 ] && exit 0

# Started by hand (the icon): re-enable autostart + watchdog after a Stop. Done after the session
# exists so the agent's own --detached run finds it and does nothing. Skipped under launchd.
for agent in com.ping-assistant.session com.ping-assistant.watchdog; do
  if ! launchctl print "gui/$(id -u)/$agent" >/dev/null 2>&1; then
    [ -f "$HOME/Library/LaunchAgents/$agent.plist" ] || cp "$REPO/launchd/$agent.plist" "$HOME/Library/LaunchAgents/"
    launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$agent.plist" && echo "autostart on: $agent" >&2
  fi
done

if [ -n "$TMUX" ]; then
  exec "$TMUX_BIN" switch-client -t "=$SESSION"
fi
exec "$TMUX_BIN" attach -t "=$SESSION"
