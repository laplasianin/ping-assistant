#!/bin/sh
# --setting-sources project: only .claude/settings.json applies, so user-level allow rules
#   (e.g. Bash(python:*), Bash(curl:*)) cannot reopen a path to Slack or to the token file.
# --permission-mode dontAsk: anything not pre-approved there is denied instead of prompting.
cd "$(dirname "$0")/.." && exec caffeinate -i claude \
  --setting-sources project --permission-mode dontAsk \
  --plugin-dir . --channels plugin:ping-assistant@local "$@"
