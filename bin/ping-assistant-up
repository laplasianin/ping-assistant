#!/bin/sh
# --setting-sources project: only .claude/settings.json applies, so user-level allow rules
#   (e.g. Bash(python:*), Bash(curl:*)) cannot reopen a path to Slack or to the token file.
# --permission-mode dontAsk: anything not pre-approved there is denied instead of prompting.
# --dangerously-load-development-channels server:ping-assistant: the server from this repo's .mcp.json
#   becomes a channel. A `plugin:…@local` channel would need the plugin *installed* (a
#   --plugin-dir load does not count), so the project-level MCP server is used instead.
# --model: the session model does triage, org answers and orchestration; research and reply
#   drafting for technical/product items are escalated to an Opus subagent by CLAUDE.md.
#   Override with PING_ASSISTANT_MODEL (e.g. claude-opus-5-5 or claude-fable-5-1).
# --add-dir: file tools (Read/Grep/Glob) only see the session cwd plus added dirs; without this the
#   research subagent could not read the Scentbird repo named in ping-assistant.config.json.
cd "$(dirname "$0")/.." || exit 1
REPO=$(bun -e 'process.stdout.write(JSON.parse(require("fs").readFileSync("ping-assistant.config.json","utf8")).scentbirdRepoPath)')
exec caffeinate -i claude \
  --setting-sources project --permission-mode dontAsk \
  --model "${PING_ASSISTANT_MODEL:-claude-sonnet-5-5}" \
  --add-dir "$REPO" \
  --dangerously-load-development-channels server:ping-assistant "$@"
